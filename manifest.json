{
  "id": "iclips",
  "name": "iClips",
  "version": "0.3.0",
  "author": {
    "name": "atzski",
    "username": "atzski"
  },
  "description": "Le studio de vos clips de jeu : un panneau en jeu pour garder le moment, une galerie pour le revoir, le couper, l'assembler ou en faire un GIF.",
  "ibox": ">=1.0.8",
  "platforms": [
    "windows"
  ],
  "permissions": [
    "clips",
    "clips-capture",
    "clips-edit",
    "overlay",
    "hotkey",
    "gamepad"
  ],
  "screen": {
    "entry": "ui/studio.html",
    "title": "iClips Studio"
  },
  "overlay": {
    "entry": "ui/panel.html",
    "side": "right",
    "width": 480,
    "hotkey": "Alt+V",
    "padCombo": [
      "back",
      "x"
    ]
  }
}

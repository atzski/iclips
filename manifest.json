{
  "id": "iclips",
  "name": "iClips",
  "version": "0.8.0",
  "author": {
    "name": "atzski",
    "username": "atzski"
  },
  "description": "Le studio de vos clips de jeu : gardez le moment à la voix (« Clip ça ! ») ou à la manette, coupez-le, assemblez, passez en vertical, puis glissez-le dans Discord ou partagez un lien.",
  "ibox": ">=1.0.8",
  "platforms": [
    "windows"
  ],
  "permissions": [
    "clips",
    "clips-capture",
    "clips-edit",
    "clips-auto",
    "clips-share",
    "clips-settings",
    "overlay",
    "gamepad"
  ],
  "screen": {
    "entry": "ui/studio.html",
    "title": "iClips Studio"
  },
  "overlay": {
    "entry": "ui/panel.html",
    "side": "right",
    "width": 480,
    "padCombo": [
      "back",
      "x"
    ]
  }
}
